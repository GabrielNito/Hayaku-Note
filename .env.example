# -----------------------------------------------------------------------------
# Hayaku Note - Docker Environment Variables
# -----------------------------------------------------------------------------
# Copy this file to .env before running: docker compose up -d
# -----------------------------------------------------------------------------

# Web App Port
PORT=3000

# PostgreSQL Database Configuration
POSTGRES_USER=hayaku
POSTGRES_PASSWORD=change_this_secret_password
POSTGRES_DB=hayaku_db
POSTGRES_PORT=5432

# 6-digit PIN bcrypt hash (Required for write operations)
# NOTE: In .env for Docker Compose, '$' must be escaped as '$$' (e.g. $$2b$$10$$...)
# Generate automatically with: bun run generate:secrets <YOUR_6_DIGIT_PIN>
PIN_HASH=

# One-time key for initial settings/authenticator setup
SETTINGS_SETUP_KEY=

# Base64 32-byte key for TOTP encryption
TOTP_ENCRYPTION_KEY=
