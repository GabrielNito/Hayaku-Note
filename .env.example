# =============================================================================
# Mesa-Pad - Environment Configuration Template
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Generate secrets automatically with:
#   bun run generate:secrets <YOUR_6_DIGIT_PIN>
# =============================================================================

# -----------------------------------------------------------------------------
# 1. APPLICATION & SECURITY SECRETS (Required for all environments)
# -----------------------------------------------------------------------------

# 6-digit PIN bcrypt hash (Gating write operations)
# - For Local Dev / Vercel: use standard hash (e.g. $2b$10$...)
# - For Docker Compose: use escaped hash (e.g. $$2b$$10$$...)
# (Both formats are accepted by the application)
PIN_HASH=

# One-time secret key for initial settings & authenticator (TOTP) setup
SETTINGS_SETUP_KEY=

# Base64-encoded 32-byte encryption key for TOTP secrets
TOTP_ENCRYPTION_KEY=


# -----------------------------------------------------------------------------
# 2. LOCAL DEV & VERCEL DEPLOYMENT
# -----------------------------------------------------------------------------
# PostgreSQL connection string (Prisma ORM)
# Required for `bun dev`, `bunx prisma db push`, or deploying to Vercel.
#
# 🐳 Local Docker Postgres container (`docker compose up -d postgres`):
DATABASE_URL="postgresql://mesapad:change_this_secret_password@localhost:5432/mesapad_db?schema=public"
#
# ☁️ Vercel / Remote Serverless Postgres (e.g. Neon, Supabase):
# DATABASE_URL="postgresql://user:password@ep-cool-pool.us-east-2.aws.neon.tech/neondb?sslmode=require"


# -----------------------------------------------------------------------------
# 3. DOCKER COMPOSE DEPLOYMENT (Self-Hosted)
# -----------------------------------------------------------------------------
# Web application exposed port (default: 3000)
PORT=3000

# PostgreSQL container configuration
# In full Docker Compose (`docker compose up -d`), DATABASE_URL is constructed
# automatically inside the container network as:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
POSTGRES_USER=mesapad
POSTGRES_PASSWORD=change_this_secret_password
POSTGRES_DB=mesapad_db
POSTGRES_PORT=5432
